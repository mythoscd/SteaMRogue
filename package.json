{
  "name": "steamrogue",
  "version": "1.1.1",
  "description": "Hepsi Bir Arada Steam Kütüphane Yöneticisi, OnlineFix Multiplayer Entegrasyonu & Otomatik Güncelleme Platformu",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^26.15.3",
    "electron-packager": "^17.1.2"
  },
  "allowScripts": {
    "electron@33.4.11": true
  },
  "build": {
    "appId": "com.steamtools.steamrogue",
    "productName": "SteaMRogue",
    "win": {
      "icon": "icon.ico",
      "target": [
        "nsis"
      ],
      "extraResources": [
        "SteamTools_Auto_Backend.exe",
        "steamtools_files"
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SteaMRogue"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json"
    ],
    "publish": {
      "provider": "github",
      "owner": "mythoscd",
      "repo": "SteaMRogue"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}